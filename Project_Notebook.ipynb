    "mask = chess['event'] == 'Rated Bullet game'\n",
    "chess_bullet = chess[mask] #Making a mask so I am just using the bullet data\n",
    "\n",
    "chess_bullet['result'] = chess_bullet['result'].replace({'1-0':1, '0-1':0, '1/2-1/2':np.nan}) #Changing results to be numerical\n",
    "chess_bullet['result'] = chess_bullet['result'].astype('float') #Dropping NaN values\n",
    "chess_bullet = chess_bullet.loc[:,['result','game_order','white_rating_diff','black_rating_diff','winner_loser_elo_diff']]\n",
    "chess_bullet = chess_bullet.dropna(axis = 0)\n",
    "labels = chess_bullet['result']\n",
    "features = chess_bullet.loc[:,['game_order','white_rating_diff','black_rating_diff','winner_loser_elo_diff']]\n",
    "\n",
    "train_vectors, test_vectors, train_labels, test_labels = train_test_split(features, labels, test_size=.25)\n",
    "\n",
    "logit_model = sm.Logit(train_labels, sm.add_constant(train_vectors))\n",
    "result = logit_model.fit() \n",
    "print(result.summary())\n",
    "\n",
    "pred = round(result.predict(sm.add_constant(test_vectors)))\n",
    "metrics.accuracy_score(y_true = test_labels, y_pred = pred) #Our accuracy is .9991 which is very good!\n",
    "\n",
    "#Plotting results\n",
    "plt.scatter(test_vectors['white_rating_diff'],pred, color = 'r')\n",
    "plt.title('Win or Lose Prediction')\n",
    "plt.xlabel('Rating Difference')\n",
    "plt.ylabel('White Win(1) or Lose(0)')"
   ]
  },
